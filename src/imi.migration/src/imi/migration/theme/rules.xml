<?xml version="1.0" encoding="UTF-8"?>
<rules
    xmlns="http://namespaces.plone.org/diazo"
    xmlns:css="http://namespaces.plone.org/diazo/css"
    xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
    xmlns:xi="http://www.w3.org/2001/XInclude">

  <!--
    Public IMI hosts keep their legacy-fidelity frontend completely unthemed.
    Admin mode is selected only by hostname.  On 127.0.0.1 and admin.* hosts,
    fall through to Barceloneta's normal rules and theme.
  -->
  <notheme if="not($host = '127.0.0.1' or starts-with($host, 'admin.'))" />

  <xi:include href="++theme++barceloneta/rules.xml" />

</rules>
