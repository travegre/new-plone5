<html xmlns="http://www.w3.org/1999/xhtml" xmlns:tal="http://xml.zope.org/namespaces/tal" xmlns:metal="http://xml.zope.org/namespaces/metal" metal:use-macro="context/main_template/macros/master">
<body><metal:main fill-slot="main">
  <h1>NADOMEŠČANJA - ENOTE</h1>
  <p><a class="btn btn-default" tal:attributes="href string:${context/absolute_url}/folder_contents">Vsebine</a> <a class="btn btn-default" tal:attributes="href string:${context/absolute_url}/@@nadomescanja-public">Poglej javna nadomeščanja</a></p>
  <h2>Uredi nadomeščanja</h2>
  <form method="get" tal:attributes="action string:${context/absolute_url}/@@nadomescanja-select">
    <p>Datum: <input name="datum" type="date" tal:attributes="value view/today_id" /></p><input class="btn btn-primary" type="submit" value="Uredi" />
  </form>
  <p>&nbsp;</p><h2>Kopiraj nadomeščanja</h2>
  <form method="get" tal:attributes="action string:${context/absolute_url}/@@nadomescanja-copy">
    <p>Obstoječi datum: <input name="star" type="date" tal:attributes="value view/today_id" /></p><p>Novi datum: <input name="nov" type="date" tal:attributes="value view/today_id" /></p><input class="btn btn-primary" type="submit" value="Kopiraj" />
  </form>
  <p>&nbsp;</p><p><a tal:attributes="href string:${context/absolute_url}/laboratoriji/folder_contents">Uredi laboratorije</a></p>
</metal:main></body></html>
