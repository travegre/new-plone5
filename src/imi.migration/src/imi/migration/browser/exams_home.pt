<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:tal="http://xml.zope.org/namespaces/tal">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>PREISKAVE</title>
  <link rel="stylesheet" tal:attributes="href string:${context/absolute_url}/++resource++imi.migration/preiskave-legacy.css" />
</head>
<body class="imi-exams-public">
  <div id="zunanji_okvir">
    <div id="okvir">
      <div class="exams-header">
        <a tal:attributes="href context/absolute_url"><img id="logo" tal:attributes="src string:${context/absolute_url}/++resource++imi.migration/logo.png" alt="IMI" /></a>
      </div>
      <div id="glavni_meni">
        <ul>
          <li class="domov"><a tal:attributes="href context/absolute_url" title="Domov">Domov</a></li>
          <li><a tal:attributes="href string:${context/absolute_url}/@@preiskave_view">Preiskave</a></li>
          <li><a tal:attributes="href string:${context/absolute_url}/@@preiskave_hitro_view">Hitro iskanje</a></li>
          <li><a tal:attributes="href string:${context/absolute_url}/@@preiskave_lab_view">Laboratoriji</a></li>
          <li><a tal:attributes="href string:${context/absolute_url}/@@preiskave_nove_view">Nove</a></li>
          <li><a tal:attributes="href string:${context/absolute_url}/@@preiskave_nujne_view">Nujne</a></li>
          <li><a tal:attributes="href string:${context/absolute_url}/@@preiskave_podrocja_view">Področja</a></li>
          <li><a tal:attributes="href string:${context/absolute_url}/@@preiskave_sklopi_view">Sklopi</a></li>
          <li><a tal:attributes="href string:${context/absolute_url}/@@preiskave_vzorci_view">Vzorci</a></li>
        </ul>
      </div>
      <div class="clear"></div>
      <main id="vsebina_podstran" class="exams-home-content">
        <h1>PREISKAVE</h1>
        <form class="exams-search" method="get" tal:attributes="action context/absolute_url">
          <label for="exam-search">Iskanje preiskav</label>
          <input id="exam-search" name="q" type="search" autocomplete="off" tal:attributes="value view/query" />
          <input type="submit" value="Išči" />
        </form>
        <div id="exam-live-results" class="LSResult"
             tal:attributes="data-search-url string:${context/absolute_url}/@@preiskave-livesearch"></div>
        <div class="exam-results" tal:condition="view/results">
          <article class="exam-result" tal:repeat="exam view/results">
            <h2><a tal:attributes="href string:${context/absolute_url}/@@preiskava-public?id=${exam/getId}" tal:content="exam/Title">Preiskava</a></h2>
            <p tal:condition="exam/Description" tal:content="exam/Description">Opis</p>
          </article>
        </div>
      </main>
      <div class="clear"></div>
    </div>
  </div>
<script>
(function () {
  var input = document.getElementById('exam-search');
  var result = document.getElementById('exam-live-results');
  var timer = null;
  if (!input || !result) { return; }
  var searchUrl = result.getAttribute('data-search-url');
  input.addEventListener('input', function () {
    window.clearTimeout(timer);
    var q = input.value.trim();
    if (q.length < 2) { result.innerHTML = ''; return; }
    timer = window.setTimeout(function () {
      fetch(searchUrl + '?q=' + encodeURIComponent(q), {credentials:'same-origin'})
        .then(function (r) { return r.text(); })
        .then(function (html) { result.innerHTML = html; });
    }, 140);
  });
}());
</script>
</body></html>
