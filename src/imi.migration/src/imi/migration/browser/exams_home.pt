<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:tal="http://xml.zope.org/namespaces/tal">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>PREISKAVE</title>
  <link rel="stylesheet" tal:attributes="href string:${context/absolute_url}/++resource++imi.migration/legacy-sites.css" />
  <link rel="stylesheet" tal:attributes="href string:${context/absolute_url}/++resource++imi.migration/preiskave-legacy.css" />
</head>
<body class="imi-exams-public">
  <div id="okol" class="exams-header"><a tal:attributes="href context/absolute_url"><img id="logo" tal:attributes="src string:${context/absolute_url}/logo.png" alt="IMI" /></a><h1><a tal:attributes="href context/absolute_url">PREISKAVE</a></h1></div>
  <div class="vsebina"><div id="podmeni"><ul class="nav_subitems"><li tal:repeat="folder view/subfolders"><a tal:attributes="href folder/url" tal:content="folder/title">Mapa</a></li></ul></div></div>
  <main id="vsebina_podstran" class="exams-home-content">
    <form class="exams-search" method="get" tal:attributes="action context/absolute_url"><label for="exam-search">Iskanje preiskav</label> <input id="exam-search" name="q" type="search" autocomplete="off" tal:attributes="value view/query" /> <input type="submit" value="Išči" /></form>
    <div id="exam-live-results" class="LSResult"></div>
    <div class="exam-results" tal:condition="view/results"><article class="exam-result" tal:repeat="exam view/results"><h2><a tal:attributes="href exam/absolute_url" tal:content="exam/Title">Preiskava</a></h2><p tal:condition="exam/Description" tal:content="exam/Description">Opis</p></article></div>
  </main>
<script>(function(){var input=document.getElementById('exam-search'),result=document.getElementById('exam-live-results'),timer=null;if(!input||!result){return;}input.addEventListener('input',function(){window.clearTimeout(timer);var q=input.value.trim();if(q.length<2){result.innerHTML='';return;}timer=window.setTimeout(function(){fetch('@@preiskave-livesearch?q='+encodeURIComponent(q),{credentials:'same-origin'}).then(function(r){return r.text();}).then(function(html){result.innerHTML=html;});},140);});}());</script>
</body></html>
