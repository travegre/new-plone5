<html xmlns="http://www.w3.org/1999/xhtml" xmlns:tal="http://xml.zope.org/namespaces/tal" xmlns:metal="http://xml.zope.org/namespaces/metal" metal:use-macro="context/main_template/macros/master">
<body><metal:main fill-slot="main">
  <div tal:define="site python:context.portal_url.getPortalObject()">
    <link rel="stylesheet" tal:attributes="href string:${site/absolute_url}/++resource++imi.migration/nadomescanja/nadomescanja_admin.css" />
    <h1 class="documentFirstHeading" tal:content="context/Title">Datum</h1>
    <p class="discreet" tal:condition="not:view/rows">Ni vnosov.</p>
    <table class="listing nadomescanja-editor-table" tal:condition="view/rows">
      <thead><tr><th>Laboratorij</th><th>Okrajšava</th><th>Privzeti vodja</th><th>Nadomestni vodja</th></tr></thead>
      <tbody><tr tal:repeat="row view/rows">
        <td tal:content="python:row.get('laboratorij_naziv') or u'—'">Laboratorij</td>
        <td tal:content="python:row.get('laboratorij_okrajsava') or u'—'">LAB</td>
        <td tal:content="python:row.get('privzeti_vodja_naziv') or u'—'">Vodja</td>
        <td tal:content="python:row.get('nadomestni_vodja_naziv') or u'—'">Nadomestnik</td>
      </tr></tbody>
    </table>
  </div>
</metal:main></body></html>