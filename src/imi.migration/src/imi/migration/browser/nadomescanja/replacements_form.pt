<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:tal="http://xml.zope.org/namespaces/tal">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Sprememba nadomeščanja</title>
  <link rel="stylesheet" tal:attributes="href string:${context/absolute_url}/++resource++imi.migration/legacy-sites.css" />
</head>
<body class="imi-replacements-public replacement-form-page">
<div id="okolo"><div id="okol">
  <a tal:attributes="href context/absolute_url"><img id="logo" tal:attributes="src string:${context/absolute_url}/++resource++imi.migration/logo.png" alt="IMI" /></a>
  <h1><a tal:attributes="href context/absolute_url">NADOMEŠČANJA - ENOTE</a></h1>
  <div class="legacy-easyform" tal:content="structure view/rendered_form">form</div>
  <p><a tal:attributes="href string:${context/absolute_url}/@@nadomescanja-public?datum=${view/requested_date}">Nazaj</a></p>
</div></div>
</body></html>
