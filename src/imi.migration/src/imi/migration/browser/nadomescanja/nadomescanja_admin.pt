<html xmlns="http://www.w3.org/1999/xhtml" xmlns:tal="http://xml.zope.org/namespaces/tal" xmlns:metal="http://xml.zope.org/namespaces/metal" lang="sl-SI" metal:use-macro="context/main_template/macros/master">
<body><metal:main fill-slot="main">
  <div tal:define="site python:context.portal_url.getPortalObject()">
    <link rel="stylesheet" tal:attributes="href string:${site/absolute_url}/++resource++imi.migration/nadomescanja/nadomescanja_admin.css" />
    <p><img class="imi-admin-logo" tal:attributes="src string:${site/absolute_url}/++resource++imi.migration/logo.png" alt="IMI" /></p>
    <h1>NADOMEŠČANJA - ENOTE</h1>
    <p><a class="btn btn-default" tal:attributes="href string:${site/absolute_url}/folder_contents">Vsebine</a> <a class="btn btn-default" tal:attributes="href string:${site/absolute_url}/@@nadomescanja-public">Poglej javna nadomeščanja</a></p>
    <h2>Uredi nadomeščanja</h2>
    <form method="get" tal:attributes="action string:${site/absolute_url}/@@nadomescanja-select">
      <p>Datum: <input name="datum" type="date" lang="sl-SI" tal:attributes="value view/today_id" /></p><input class="btn btn-primary" type="submit" value="Uredi" />
    </form>
    <p>&nbsp;</p><h2>Kopiraj nadomeščanja</h2>
    <form method="get" tal:attributes="action string:${site/absolute_url}/@@nadomescanja-copy">
      <p>Obstoječi datum: <input name="star" type="date" lang="sl-SI" tal:attributes="value view/today_id" /></p><p>Novi datum: <input name="nov" type="date" lang="sl-SI" tal:attributes="value view/today_id" /></p><input class="btn btn-primary" type="submit" value="Kopiraj" />
    </form>
    <p>&nbsp;</p><h2>Laboratoriji in privzeti vodje</h2>
    <table class="listing nadomescanja-editor-table"><thead><tr><th>Laboratorij</th><th>Okrajšava</th><th>Privzeti vodja</th><th></th></tr></thead>
      <tbody><tr tal:repeat="lab view/admin_laboratories"><td tal:content="lab/title">Lab</td><td tal:content="lab/abbreviation">LAB</td><td tal:content="lab/leader">Vodja</td><td><a tal:attributes="href string:${lab/url}/edit">Uredi</a></td></tr></tbody>
    </table>
  </div>
</metal:main></body></html>
