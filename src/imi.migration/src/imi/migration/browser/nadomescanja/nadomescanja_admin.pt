<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      lang="sl-SI"
      metal:use-macro="context/main_template/macros/master">
<body>
  <metal:title fill-slot="content-title">
    <h1 class="documentFirstHeading">NADOMEŠČANJA - ENOTE</h1>
  </metal:title>
  <metal:core fill-slot="content-core">
    <div tal:define="site python:context.portal_url.getPortalObject()">
      <link rel="stylesheet" tal:attributes="href string:${site/absolute_url}/++resource++imi.migration/sl_calendar.css" />
  <script tal:attributes="src string:${site/absolute_url}/++resource++imi.migration/sl_calendar.js"></script>
  
      <link rel="stylesheet" tal:attributes="href string:${site/absolute_url}/++resource++imi.migration/nadomescanja/nadomescanja_admin.css" />
      <link rel="stylesheet" tal:attributes="href string:${site/absolute_url}/++resource++imi.migration/dezurstva/dezurstva_admin.css" />
      <p><a class="btn btn-default" tal:attributes="href string:${site/absolute_url}/folder_contents">Vsebine</a>
         <a class="btn btn-default" tal:attributes="href string:${site/absolute_url}/@@nadomescanja-public">Poglej javna nadomeščanja</a></p>

      <form tal:attributes="action string:${site/absolute_url}/@@nadomescanja-select"
            method="get" class="enableFormTabbing pat-formautofocus">
        <fieldset>
          <legend>Uredi nadomeščanja</legend>
          <div class="field">
            <label for="nad-datum">Datum</label>
            <div class="formHelp">Izberite datum obstoječih ali novih nadomeščanj.</div>
            <input id="nad-datum" name="datum" type="date" lang="sl-SI"
                   required="required" tal:attributes="value view/today_id" />
          </div>
          <div class="formControls">
            <button type="submit" class="context">Uredi</button>
          </div>
        </fieldset>
      </form>

      <form tal:attributes="action string:${site/absolute_url}/@@nadomescanja-copy"
            method="get" class="enableFormTabbing" style="margin-top: 2em;">
        <fieldset>
          <legend>Kopiraj nadomeščanja</legend>
          <div class="field">
            <label for="nad-star">Obstoječi datum</label>
            <div class="formHelp">Datum nadomeščanj, ki jih želite kopirati.</div>
            <input id="nad-star" name="star" type="date" lang="sl-SI"
                   required="required" tal:attributes="value view/today_id" />
          </div>
          <div class="field">
            <label for="nad-nov">Novi datum</label>
            <div class="formHelp">Datum nove kopije nadomeščanj.</div>
            <input id="nad-nov" name="nov" type="date" lang="sl-SI"
                   required="required" tal:attributes="value view/today_id" />
          </div>
          <div class="formControls">
            <button type="submit" class="context">Kopiraj</button>
          </div>
        </fieldset>
      </form>

      <h2>Laboratoriji in privzeti vodje</h2>
      <table class="listing nadomescanja-editor-table">
        <thead><tr><th>Laboratorij</th><th>Okrajšava</th><th>Privzeti vodja</th><th></th></tr></thead>
        <tbody>
          <tr tal:repeat="lab view/admin_laboratories">
            <td tal:content="lab/title">Lab</td>
            <td tal:content="lab/abbreviation">LAB</td>
            <td tal:content="lab/leader">Vodja</td>
            <td><a tal:attributes="href string:${lab/url}/edit">Uredi</a></td>
          </tr>
        </tbody>
      </table>
    </div>
  </metal:core>
</body>
</html>
