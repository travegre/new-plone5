<html xmlns="http://www.w3.org/1999/xhtml" xmlns:tal="http://xml.zope.org/namespaces/tal" xmlns:metal="http://xml.zope.org/namespaces/metal" metal:use-macro="context/main_template/macros/master">
<body><metal:main fill-slot="main">
  <h1>Uredi nadomeščanja</h1>
  <h2 tal:content="context/Title">Datum</h2>
  <form method="post" class="replacement-editor">
    <table class="listing replacement-editor-table">
      <thead><tr><th>Enota</th><th>Vodja</th><th>Nadomešča</th></tr></thead>
      <tbody><tr tal:repeat="row view/edit_rows">
        <td tal:content="row/abbreviation">Enota</td>
        <td tal:content="row/leader">Vodja</td>
        <td><select tal:attributes="name row/field"><option value=""></option>
          <option tal:repeat="option view/staff_options"
                  tal:attributes="value python:option[0]; selected python:option[0] == row['selected']"
                  tal:content="python:option[1]">Ime</option>
        </select></td>
      </tr></tbody>
    </table>
    <div class="formControls"><input class="btn btn-primary" type="submit" value="Shrani" /> <a class="btn btn-default" tal:attributes="href string:${context/portal_url}/@@nadomescanja-admin">Nazaj</a></div>
  </form>
</metal:main></body></html>
