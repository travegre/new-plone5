<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      lang="sl-SI"
      metal:use-macro="context/main_template/macros/master">
<body>
  <metal:title fill-slot="content-title">
    <h1 class="documentFirstHeading">KIESTRA</h1>
  </metal:title>
  <metal:core fill-slot="content-core">
    <div tal:define="site python:context.portal_url.getPortalObject()">
      <link rel="stylesheet" tal:attributes="href string:${site/absolute_url}/++resource++imi.migration/sl_calendar.css" />
  <script tal:attributes="src string:${site/absolute_url}/++resource++imi.migration/sl_calendar.js"></script>
  
      <link rel="stylesheet" tal:attributes="href string:${site/absolute_url}/++resource++imi.migration/dezurstva/dezurstva_admin.css" />

      <form tal:attributes="action string:${site/absolute_url}/@@kiestra-select"
            method="get" class="enableFormTabbing pat-formautofocus">
        <fieldset>
          <legend>Uredi dežurstvo</legend>
          <div class="field">
            <label for="kiestra-datum">Datum</label>
            <div class="formHelp">Izberite datum obstoječega ali novega dežurstva.</div>
            <input id="kiestra-datum" name="datum" type="date" lang="sl-SI"
                   required="required" tal:attributes="value view/today_id" />
          </div>
          <div class="formControls">
            <button type="submit" class="context">Uredi</button>
          </div>
        </fieldset>
      </form>

      <form tal:attributes="action string:${site/absolute_url}/@@kiestra-copy"
            method="get" class="enableFormTabbing" style="margin-top: 2em;">
        <fieldset>
          <legend>Kopiraj dežurstvo</legend>
          <div class="field">
            <label for="kiestra-star">Obstoječi datum</label>
            <div class="formHelp">Datum dežurstva, ki ga želite kopirati.</div>
            <input id="kiestra-star" name="star" type="date" lang="sl-SI"
                   required="required" tal:attributes="value view/today_id" />
          </div>
          <div class="field">
            <label for="kiestra-nov">Novi datum</label>
            <div class="formHelp">Datum nove kopije dežurstva.</div>
            <input id="kiestra-nov" name="nov" type="date" lang="sl-SI"
                   required="required" tal:attributes="value view/today_id" />
          </div>
          <div class="formControls">
            <button type="submit" class="context">Kopiraj</button>
          </div>
        </fieldset>
      </form>
    </div>
  </metal:core>
</body>
</html>
