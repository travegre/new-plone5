<html xmlns="http://www.w3.org/1999/xhtml" xmlns:tal="http://xml.zope.org/namespaces/tal" xmlns:metal="http://xml.zope.org/namespaces/metal" metal:use-macro="context/main_template/macros/master">
<body>
<metal:title fill-slot="content-title"><h1 class="documentFirstHeading">Kiestra – <span tal:replace="context/Title">Datum</span></h1></metal:title>
<metal:core fill-slot="content-core">
<link rel="stylesheet" tal:attributes="href string:${context/portal_url}/++resource++imi.migration/kiestra/editor.css" />
<div class="formControls" style="margin-bottom:1.5em">
<a class="btn btn-primary" tal:attributes="href string:${context/absolute_url}/@@kiestra-edit">Uredi</a>
<a class="btn btn-default" tal:attributes="href string:${context/portal_url}/@@kiestra-admin">Nazaj na pregled</a>
</div>
<div class="kiestra-editor-grid">
<section class="kiestra-editor-field" tal:repeat="row view/fields">
<h3 tal:content="row/label">Polje</h3>
<ul tal:condition="row/people"><li tal:repeat="person row/people" tal:content="person">Oseba</li></ul>
<p tal:condition="not:row/people">—</p>
<p tal:condition="row/note"><strong>Opomba:</strong> <span tal:replace="row/note">Besedilo</span></p>
</section>
</div>
<div class="kiestra-constant" tal:condition="view/constant_text"><h3>Stalni tekst</h3><div tal:replace="structure view/constant_text">Besedilo</div></div>
</metal:core>
</body></html>
