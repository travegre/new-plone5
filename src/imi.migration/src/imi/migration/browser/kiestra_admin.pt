<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      metal:use-macro="context/main_template/macros/master">
<body>
<metal:main fill-slot="main">
  <p><img class="imi-admin-logo" tal:attributes="src string:${context/absolute_url}/++resource++imi.migration/logo.png" alt="IMI" /></p>
  <h1>KIESTRA</h1>
  <p>
    <a class="btn btn-default" tal:attributes="href string:${context/absolute_url}/folder_contents">Vsebine</a>
    <a class="btn btn-default" tal:attributes="href context/absolute_url">Poglej javni razpored</a>
  </p>
  <h2>Uredi dežurstvo</h2>
  <form tal:attributes="action string:${context/absolute_url}/@@kiestra-select" method="get">
    <p>Datum: <input name="datum" type="date" lang="sl" tal:attributes="value view/today_id" /></p>
    <input class="btn btn-primary" type="submit" value="Uredi" />
  </form>
  <p>&nbsp;</p>
  <h2>Kopiraj dežurstvo</h2>
  <form tal:attributes="action string:${context/absolute_url}/@@kiestra-copy" method="get">
    <p>Obstoječi datum: <input name="star" type="date" lang="sl" tal:attributes="value view/today_id" /></p>
    <p>Novi datum: <input name="nov" type="date" lang="sl" tal:attributes="value view/today_id" /></p>
    <input class="btn btn-primary" type="submit" value="Kopiraj" />
  </form>
  <script tal:attributes="src string:${context/absolute_url}/++resource++imi.migration/legacy-date-picker.js"></script>
</metal:main>
</body>
</html>
