<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:tal="http://xml.zope.org/namespaces/tal">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title tal:content="context/Title">Preiskava</title>
  <link rel="stylesheet" tal:attributes="href string:${context/portal_url}/++resource++imi.migration/legacy-sites.css" />
</head>
<body class="imi-exams-public">
  <div id="okol" class="exams-header">
    <a tal:attributes="href context/portal_url"><img id="logo" tal:attributes="src string:${context/portal_url}/++resource++imi.migration/logo.png" alt="IMI" /></a>
    <h1><a tal:attributes="href context/portal_url">PREISKAVE</a></h1>
  </div>
  <main id="vsebina_podstran" class="examination-detail">
    <p class="text text-10 exam-title" tal:content="context/Title">Preiskava</p>
    <div class="preiskava_opis_container">
      <p class="text text-12 siv-tekst">Področje preiskave</p>
      <p class="text text-13" tal:content="python:', '.join(dict.fromkeys(context.podrocje or ()))"></p>
      <tal:opis condition="python:bool(view.rich('opis'))"><p class="text text-12 siv-tekst">Opis preiskave</p><div class="text text-13" tal:content="structure python:view.rich('opis')"></div></tal:opis>
      <tal:file condition="context/datoteka|nothing"><p class="text text-12 siv-tekst">Dodatna dokumentacija:</p><p class="text text-13"><a tal:attributes="href string:${context/absolute_url}/@@download/datoteka/${context/datoteka/filename}" tal:content="context/datoteka/filename">datoteka</a></p></tal:file>
      <tal:opombe condition="python:bool(view.rich('opombe'))"><p class="text text-12 siv-tekst">Opombe</p><div class="text text-13" tal:content="structure python:view.rich('opombe')"></div></tal:opombe>
    </div>

    <div class="preiskava_vzorci_container" tal:condition="view/sample_rows">
      <p class="text text-14">Vzorci in navodila</p>
      <div class="div_vzorci">
        <div class="neki sample-card" tal:repeat="sample view/sample_rows">
          <p class="naslov_vzorca text text-14" tal:content="sample/name">Vzorec</p>
          <tal:collection condition="sample/collection"><div class="vzorec_levo">Navodila za odvzem:</div><div class="vzorec_desno" tal:content="structure sample/collection"></div></tal:collection>
          <tal:transport condition="sample/transport"><div class="vzorec_levo">Navodila za transport:</div><div class="vzorec_desno" tal:content="structure sample/transport"></div></tal:transport>
          <tal:amount condition="sample/amount"><div class="vzorec_levo">Količina in embalaža:</div><div class="vzorec_desno" tal:content="structure sample/amount"></div></tal:amount>
          <tal:note condition="sample/note"><div class="vzorec_levo">Opomba za klinika:</div><div class="vzorec_desno" tal:content="structure sample/note"></div></tal:note>
          <tal:pack condition="sample/packaging"><div class="vzorec_levo">Priporočena embalaža:</div><div class="packaging-images"><a tal:repeat="code sample/packaging" tal:attributes="href python:view.packaging_url(code)"><img class="embalaza_slika" tal:attributes="src python:view.packaging_url(code); alt code" /></a></div></tal:pack>
          <tal:video condition="sample/video"><div class="vzorec_levo">Video:</div><div class="vzorec_desno"><a tal:attributes="href sample/video" tal:content="sample/video">Video</a></div></tal:video>
          <div class="sample-labs" tal:condition="sample/labs">
            <div class="sample-lab" tal:repeat="lab sample/labs">
              <div class="vzorec_levo lab" tal:content="lab/name">Laboratorij</div>
              <div class="vzorec_desno lab" tal:condition="lab/phone">Telefon: <span class="tel" tal:content="lab/phone"></span></div>
              <div class="vzorec_levo" tal:condition="lab/code">Lab kratica:</div><div class="vzorec_desno" tal:condition="lab/code" tal:content="lab/code"></div>
            </div>
          </div>
          <div class="clear"></div>
        </div>
      </div>
    </div>

    <div class="preiskava_tech_data">
      <div><p class="text text-16">Šifra preiskave</p><p class="text text-17" tal:content="view/code"></p></div>
      <div tal:condition="python:bool(view.text('laboratoriji'))"><p class="text text-16">Laboratoriji</p><p class="text text-17" tal:content="structure python:view.text('laboratoriji')"></p></div>
      <div tal:condition="python:bool(view.rich('urnik'))"><p class="text text-16">Urnik izvajanja</p><div class="text text-17" tal:content="structure python:view.rich('urnik')"></div></div>
      <div tal:condition="python:bool(view.rich('trajanje'))"><p class="text text-16">Trajanje preiskave</p><div class="text text-17" tal:content="structure python:view.rich('trajanje')"></div></div>
      <div tal:condition="python:bool(view.rich('metode'))"><p class="text text-16">Metode preiskave</p><div class="text text-17" tal:content="structure python:view.rich('metode')"></div></div>
    </div>
    <p class="exam-editor-link" tal:condition="view/is_editor"><a tal:attributes="href string:${context/absolute_url}/edit">Uredi</a></p>
  </main>
</body>
</html>
