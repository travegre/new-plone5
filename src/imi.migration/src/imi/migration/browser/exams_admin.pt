<html xmlns="http://www.w3.org/1999/xhtml" xmlns:tal="http://xml.zope.org/namespaces/tal" xmlns:metal="http://xml.zope.org/namespaces/metal" metal:use-macro="context/main_template/macros/master">
<body><metal:main fill-slot="main">
  <h1>PREISKAVE</h1>
  <p>
    <a class="btn btn-primary" tal:attributes="href string:${context/absolute_url}/folder_contents">Vsebine</a>
    <a class="btn btn-default" tal:attributes="href string:${context/absolute_url}/@@preiskave-public">Poglej javne preiskave</a>
    <a class="btn btn-default" tal:attributes="href string:${context/absolute_url}/@@preiskave-uvoz">Uvoz preiskav</a>
  </p>
  <h2>Pregledi preiskav</h2>
  <ul>
    <li><a tal:attributes="href string:${context/absolute_url}/@@preiskave_view">Preiskave</a></li>
    <li><a tal:attributes="href string:${context/absolute_url}/@@preiskave_hitro_view">Hitro iskanje</a></li>
    <li><a tal:attributes="href string:${context/absolute_url}/@@preiskave_lab_view">Preiskave po laboratorijih</a></li>
    <li><a tal:attributes="href string:${context/absolute_url}/@@preiskave_nove_view">Nove preiskave</a></li>
    <li><a tal:attributes="href string:${context/absolute_url}/@@preiskave_nujne_view">Nujne preiskave</a></li>
    <li><a tal:attributes="href string:${context/absolute_url}/@@preiskave_podrocja_view">Preiskave po področjih</a></li>
    <li><a tal:attributes="href string:${context/absolute_url}/@@preiskave_sklopi_view">Preiskave po sklopih</a></li>
    <li><a tal:attributes="href string:${context/absolute_url}/@@preiskave_vzorci_view">Preiskave po vzorcih</a></li>
  </ul>
  <h2>Področja</h2>
  <ul><li tal:repeat="folder view/subfolders"><a tal:attributes="href folder/url" tal:content="folder/title">Mapa</a></li></ul>
</metal:main></body></html>
