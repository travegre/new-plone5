<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      metal:use-macro="context/main_template/macros/master">
<body>
  <metal:main fill-slot="main">
    <h1>IMENIK</h1>
    <p>Upravljanje imenika</p>
    <p>
      <a class="btn btn-primary" tal:attributes="href string:${context/absolute_url}/folder_contents">Vsebine</a>
      <a class="btn btn-default" tal:attributes="href string:${context/absolute_url}/@@imenik-public">Poglej javni imenik</a>
      <a class="btn btn-default" tal:attributes="href string:${context/absolute_url}/@@imenik-uvoz">Uvoz podatkov</a>
    </p>
    <h2>Kategorije</h2>
    <ul>
      <li tal:repeat="category view/categories">
        <strong tal:content="category/title">Kategorija</strong>
        <span tal:condition="category/children"> — <span tal:replace="python:', '.join(category['children'])">podkategorije</span></span>
      </li>
    </ul>
  </metal:main>
</body>
</html>
