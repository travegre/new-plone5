<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      metal:use-macro="context/main_template/macros/master">
<body><metal:main fill-slot="main">
  <h1>Uvoz podatkov v IMENIK</h1>
  <p>Ta funkcija nadomešča stari objekt <code>uvoz</code>. Sprejme isti dve podpičji ločeni datoteki kot Plone 4.</p>
  <form method="post" enctype="multipart/form-data" tal:attributes="action string:${context/absolute_url}/@@imenik-uvoz">
    <div class="field">
      <label for="datoteka">Datoteka</label>
      <input id="datoteka" name="datoteka" type="file" required="required" />
    </div>
    <div class="field">
      <label for="datoteka2">Datoteka s strukturo podrocij</label>
      <input id="datoteka2" name="datoteka2" type="file" />
    </div>
    <div class="field">
      <label><input name="update_existing" type="checkbox" value="1" /> Posodobi tudi že obstoječe osebe</label>
      <p class="formHelp">Stari importer je obstoječe vnose preskočil; zato je ta možnost privzeto izklopljena.</p>
    </div>
    <div class="formControls"><button class="btn btn-primary" type="submit">Uvozi</button></div>
  </form>

  <div tal:condition="view/error" class="portalMessage error"><strong>Napaka:</strong> <span tal:replace="view/error"></span></div>
  <div tal:condition="view/report">
    <h2>Rezultat uvoza</h2>
    <dl>
      <dt>Datoteka</dt><dd tal:content="view/report/filename"></dd>
      <dt>Struktura</dt><dd tal:content="view/report/structure_filename"></dd>
      <dt>Ustvarjenih</dt><dd tal:content="view/report/created"></dd>
      <dt>Posodobljenih</dt><dd tal:content="view/report/updated"></dd>
      <dt>Preskočenih</dt><dd tal:content="view/report/skipped"></dd>
    </dl>
    <div tal:condition="view/report/errors"><h3>Napake</h3><ul><li tal:repeat="error view/report/errors" tal:content="error"></li></ul></div>
  </div>
  <p><a tal:attributes="href context/absolute_url">Nazaj na IMENIK</a></p>
</metal:main></body></html>
