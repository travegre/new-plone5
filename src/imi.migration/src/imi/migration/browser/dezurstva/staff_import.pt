<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      metal:use-macro="context/main_template/macros/master">
<body><metal:main fill-slot="main">
  <h1>Uvoz zaposlenih</h1>
  <p>Ta funkcija nadomešča Excel polji na starem objektu <code>seznam_zaposlenih</code>.</p>
  <form method="post" enctype="multipart/form-data" tal:attributes="action string:${context/absolute_url}/@@dezurstva-uvoz-zaposlenih">
    <input tal:replace="structure context/@@authenticator/authenticator" />
    <div class="field">
      <label for="datoteka1">Datoteka z zaposlenimi</label>
      <input id="datoteka1" name="datoteka1" type="file" accept=".xls,.xlsx,.xlsm" />
      <p class="formHelp">Stari prvi uvoz je ustvarjal nove zaposlene in je obstoječe preskočil.</p>
    </div>
    <div class="field">
      <label for="datoteka2">Dodaj telefonske</label>
      <input id="datoteka2" name="datoteka2" type="file" accept=".xls,.xlsx,.xlsm" />
      <p class="formHelp">Ta datoteka posodobi kontakt in e-pošto obstoječih zaposlenih ter ustvari manjkajoče.</p>
    </div>
    <div class="formControls"><button class="btn btn-primary" type="submit">Uvozi</button></div>
  </form>

  <div tal:condition="view/error" class="portalMessage error"><strong>Napaka:</strong> <span tal:replace="view/error"></span></div>
  <div tal:condition="view/report">
    <h2>Rezultat uvoza</h2>
    <dl>
      <dt>Datoteka z zaposlenimi</dt><dd tal:content="view/report/base_filename"></dd>
      <dt>Dodaj telefonske</dt><dd tal:content="view/report/phone_filename"></dd>
      <dt>Ustvarjenih</dt><dd tal:content="view/report/created"></dd>
      <dt>Posodobljenih</dt><dd tal:content="view/report/updated"></dd>
      <dt>Preskočenih</dt><dd tal:content="view/report/skipped"></dd>
    </dl>
    <div tal:condition="view/report/errors"><h3>Napake</h3><ul><li tal:repeat="error view/report/errors" tal:content="error"></li></ul></div>
  </div>
  <p><a tal:attributes="href context/absolute_url">Nazaj na Dežurstva</a></p>
</metal:main></body></html>
