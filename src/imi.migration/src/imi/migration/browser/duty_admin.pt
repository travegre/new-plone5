<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      metal:use-macro="context/main_template/macros/master">
  <body>
    <metal:main fill-slot="main">
      <h1>Urejanje dežurstev</h1>

      <section>
        <h2>Uredi dežurstvo</h2>
        <form action="@@izberi_dezurstvo" method="get">
          <label for="datum">Datum</label>
          <input id="datum" name="datum" type="date" required="required" />
          <button type="submit">Uredi</button>
        </form>
      </section>

      <section style="margin-top: 2em;">
        <h2>Kopiraj dežurstvo</h2>
        <form action="@@kopiraj_dezurstvo" method="post">
          <label for="star">Obstoječi datum</label>
          <input id="star" name="star" type="date" required="required" />

          <label for="nov">Novi datum</label>
          <input id="nov" name="nov" type="date" required="required" />

          <button type="submit">Kopiraj</button>
        </form>
      </section>
    </metal:main>
  </body>
</html>
