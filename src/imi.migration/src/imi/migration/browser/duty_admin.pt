<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      metal:use-macro="context/main_template/macros/master">
  <body>
    <metal:title fill-slot="content-title">
      <h1 class="documentFirstHeading">Urejanje dežurstev</h1>
    </metal:title>

    <metal:core fill-slot="content-core">
      <p><img class="imi-admin-logo" tal:attributes="src string:${context/absolute_url}/++resource++imi.migration/logo.png" alt="IMI" /></p>
      <p><a class="btn btn-default" tal:attributes="href string:${context/absolute_url}/@@dezurstva-uvoz-zaposlenih">Uvoz zaposlenih</a></p>

      <form action="@@izberi_dezurstvo"
            method="get"
            class="enableFormTabbing pat-formautofocus">
        <fieldset>
          <legend>Uredi dežurstvo</legend>

          <div class="field">
            <label for="datum">Datum</label>
            <div class="formHelp">Izberite datum obstoječega ali novega dežurstva.</div>
            <input id="datum"
                   name="datum"
                   type="date"
                   required="required" />
          </div>

          <div class="formControls">
            <button type="submit" class="context">Uredi</button>
          </div>
        </fieldset>
      </form>

      <form action="@@kopiraj_dezurstvo"
            method="post"
            class="enableFormTabbing"
            style="margin-top: 2em;">
        <fieldset>
          <legend>Kopiraj dežurstvo</legend>

          <div class="field">
            <label for="star">Obstoječi datum</label>
            <div class="formHelp">Datum dežurstva, ki ga želite kopirati.</div>
            <input id="star"
                   name="star"
                   type="date"
                   required="required" />
          </div>

          <div class="field">
            <label for="nov">Novi datum</label>
            <div class="formHelp">Datum nove kopije dežurstva.</div>
            <input id="nov"
                   name="nov"
                   type="date"
                   required="required" />
          </div>

          <div class="formControls">
            <button type="submit" class="context">Kopiraj</button>
          </div>
        </fieldset>
      </form>
    </metal:core>
  </body>
</html>
