<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser">

  <browser:page
      name="dezurstva-home"
      for="Products.CMFCore.interfaces.ISiteRoot"
      class=".duty.DutyHomeView"
      permission="zope2.View"
      />

  <browser:page
      name="dezurstva-public"
      for="Products.CMFCore.interfaces.ISiteRoot"
      class=".duty.DutyPublicView"
      permission="zope2.View"
      />

  <browser:page
      name="dezurstva-izvoz"
      for="Products.CMFCore.interfaces.ISiteRoot"
      class=".duty.DutyExportView"
      permission="zope2.View"
      />

  <browser:page
      name="dezurstva-admin"
      for="Products.CMFCore.interfaces.ISiteRoot"
      class=".duty.DutyAdminView"
      template="duty_admin.pt"
      permission="cmf.ModifyPortalContent"
      />

  <browser:page
      name="dezurstva_admin"
      for="Products.CMFCore.interfaces.ISiteRoot"
      class=".duty.DutyAdminView"
      template="duty_admin.pt"
      permission="cmf.ModifyPortalContent"
      />

  <browser:page
      name="izberi_dezurstvo"
      for="Products.CMFCore.interfaces.ISiteRoot"
      class=".duty.SelectDutyView"
      permission="cmf.AddPortalContent"
      />

  <browser:page
      name="kopiraj_dezurstvo"
      for="Products.CMFCore.interfaces.ISiteRoot"
      class=".duty.CopyDutyView"
      permission="cmf.AddPortalContent"
      />

</configure>
